		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.3",
		"cn": "^0.5.2",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
